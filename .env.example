# Copy to .env (never committed) and fill in. docker compose reads these from the shell / .env.
# All LLM traffic goes through these two variables (contract/README.md, runtime rule 3).
LLM_BASE_URL=
LLM_API_KEY=

# Dev only: stop paid calls once cumulative spend reaches this many USD.
# Unset (or absent) = no stop. The shipped compose file never sets it.
DEV_BUDGET_USD=8

# Optional LLM wrapper tuning (defaults shown; P2-07, P2-28). Apply in shipped config too.
# LLM_MAX_CONCURRENCY=4
# LLM_MAX_CALLS_PER_DOC=8
# LLM_MAX_USD_PER_DOC=0.05
# LLM_REQUEST_TIMEOUT_S=120

# DOCX page numbers (P3-27): none (default; no [Page N] for DOCX) | estimate (proportional).
# DOCX_PAGE_METHOD=none
# Dev only, set by compose.dev.yaml: LLM_CACHE_DIR (disk cache), LLM_BREAKER_ABORT (scripts).
