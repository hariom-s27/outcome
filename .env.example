# Copy to .env (never committed) and fill in. docker compose reads these from the shell / .env.
# All LLM traffic goes through these two variables (contract/README.md, runtime rule 3).
LLM_BASE_URL=
LLM_API_KEY=

# Dev only: stop paid calls once cumulative spend reaches this many USD.
# Unset (or absent) = no stop. The shipped compose file never sets it.
DEV_BUDGET_USD=8
